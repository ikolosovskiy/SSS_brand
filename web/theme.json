{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "lis",
          "name": "Ліс",
          "color": "#314C2C"
        },
        {
          "slug": "glybyna",
          "name": "Глибина",
          "color": "#1B2A18"
        },
        {
          "slug": "moloko",
          "name": "Молоко",
          "color": "#FBF6EC"
        },
        {
          "slug": "sonyashnyk",
          "name": "Соняшник",
          "color": "#F6B93B"
        },
        {
          "slug": "terakota",
          "name": "Теракота",
          "color": "#DC643D"
        },
        {
          "slug": "parostok",
          "name": "Паросток",
          "color": "#A9D48E"
        },
        {
          "slug": "nebo",
          "name": "Небо",
          "color": "#D7E6FB"
        },
        {
          "slug": "kamin",
          "name": "Камінь",
          "color": "#66705F"
        },
        {
          "slug": "pisok",
          "name": "Пісок",
          "color": "#E6DFD0"
        },
        {
          "slug": "white",
          "name": "Білий",
          "color": "#FFFFFF"
        }
      ],
      "gradients": [
        {
          "slug": "ranok",
          "name": "Ранок",
          "gradient": "linear-gradient(135deg,#F6B93B 0%,#DC643D 100%)"
        },
        {
          "slug": "pole",
          "name": "Поле",
          "gradient": "linear-gradient(135deg,#A9D48E 0%,#F6B93B 100%)"
        },
        {
          "slug": "lis",
          "name": "Ліс",
          "gradient": "linear-gradient(180deg,#314C2C 0%,#1B2A18 100%)"
        },
        {
          "slug": "prostir",
          "name": "Простір",
          "gradient": "linear-gradient(180deg,#D7E6FB 0%,#FBF6EC 100%)"
        },
        {
          "slug": "foto",
          "name": "Фото-накладка",
          "gradient": "linear-gradient(180deg,rgba(27,42,24,0) 40%,rgba(27,42,24,.85) 100%)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif"
        },
        {
          "slug": "onest",
          "name": "Onest",
          "fontFamily": "Onest, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Малий",
          "size": "15px"
        },
        {
          "slug": "body",
          "name": "Текст",
          "size": "18px"
        },
        {
          "slug": "lead",
          "name": "Лід",
          "size": "21px"
        },
        {
          "slug": "h3",
          "name": "H3",
          "size": "clamp(22px,2.2vw,28px)"
        },
        {
          "slug": "h2",
          "name": "H2",
          "size": "clamp(28px,3.4vw,44px)"
        },
        {
          "slug": "h1",
          "name": "H1",
          "size": "clamp(36px,5vw,64px)"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--moloko)",
      "text": "var(--wp--preset--color--glybyna)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--onest)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "800",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.08"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--lis)"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--sonyashnyk)",
          "text": "var(--wp--preset--color--glybyna)"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700",
          "fontSize": "16px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "#EBA92A"
          }
        }
      }
    }
  }
}